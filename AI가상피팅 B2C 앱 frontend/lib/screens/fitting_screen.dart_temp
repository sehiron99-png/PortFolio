                                                                              0,
                                                                          end:
                                                                              1),
                                                                      builder: (context,
                                                                          double
                                                                              val,
                                                                          child) {
                                                                        return Transform
                                                                            .translate(
                                                                          offset: Offset(
                                                                              0,
                                                                              math.sin(val * math.pi * 2) * 4),
                                                                          child:
