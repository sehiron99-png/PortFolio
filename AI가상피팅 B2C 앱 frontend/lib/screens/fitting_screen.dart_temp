                                await Future.delayed(const Duration(milliseconds: 100));
                                if (mounted) setState(() => _isSearchPressed = false);
                              },
                              onTap: () {
                                setState(() {
                                  _isSearchMode = !_isSearchMode;
                                  if (!_isSearchMode) {
