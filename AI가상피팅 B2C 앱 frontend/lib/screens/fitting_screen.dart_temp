                                                      provider.userPhotoPath !=
                                                              null
                                                          ? (kIsWeb 
                                                              ? Image.network(
                                                                  provider.userPhotoPath!,
                                                                  fit: BoxFit.cover,
                                                                  alignment: Alignment.center,
                                                                )
                                                              : Image.file(
                                                                  File(provider
                                                                      .userPhotoPath!),
                                                                  fit: BoxFit.cover,
                                                                  alignment: Alignment.center,
                                                                ))
                                                          : Container(
                                                              decoration:
                                                                  BoxDecoration(
                                                                gradient:
                                                                    LinearGradient(
                                                                  begin: Alignment
                                                                      .topCenter,
                                                                  end: Alignment
                                                                      .bottomCenter,
                                                                  colors: [
                                                                    Colors
                                                                        .white,
                                                                    AppTheme
                                                                        .secondary
                                                                        .withValues(
                                                                            alpha:
                                                                                0.25),
                                                                  ],
                                                                ),
                                                              ),
                                                              child: Center(
                                                                child: Column(
